BETTER_AUTH_URL=
VITE_AUTH_ENABLED=false

# Optional TURN configuration. The server exposes these only through
# /api/rtc/config; do not prefix them with VITE_.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
