# Server-only production secrets/configuration.
# Never commit real values here.

DATABASE_URL=

# Better Auth configuration. Never commit real credentials.
BETTER_AUTH_SECRET=
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
